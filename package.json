{
  "name": "nature-green",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "npm run generate:sitemap && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "convert:webp": "node scripts/convert-images-to-webp.mjs",
    "analyze:bundle": "ng build --configuration production --source-map && source-map-explorer \"dist/nature-green/browser/**/*.js\"",
    "serve:ssr:nature-green": "node dist/nature-green/server/server.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/platform-browser": "^21.1.0",
    "@angular/platform-server": "^21.1.0",
    "@angular/router": "^21.1.0",
    "@angular/ssr": "^21.2.10",
    "@types/compression": "^1.8.1",
    "compression": "^1.8.1",
    "express": "^5.1.0",
    "lucide-angular": "^1.0.0",
    "rxjs": "~7.8.0",
    "sharp": "^0.34.5",
    "source-map-explorer": "^2.5.3",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.1.2",
    "@angular/cli": "^21.1.2",
    "@angular/compiler-cli": "^21.1.0",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "typescript": "~5.9.2"
  }
}
